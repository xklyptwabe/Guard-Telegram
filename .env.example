# Required
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgres://telegram_bot:change-me@db.example.internal:5432/telegram_bot

# General
NODE_ENV=development
LOG_LEVEL=info
TELEGRAM_TRANSPORT=long_polling
TELEGRAM_ALLOWED_UPDATES=message,callback_query,my_chat_member
TELEGRAM_RUNNER_CONCURRENCY=25
TELEGRAM_TOPIC_FALLBACK_TO_CHAT=false

# Webhook (required only for TELEGRAM_TRANSPORT=webhook)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8080

# PostgreSQL TLS
DATABASE_TLS_REJECT_UNAUTHORIZED=true
# DATABASE_TLS_CA=
# DATABASE_TLS_CERT=
# DATABASE_TLS_KEY=

# Optional backend API. Keep disabled unless an authenticated backend client
# is deployed in front of the frontend; tokens are Bearer credentials.
BACKEND_API_ENABLED=false
BACKEND_API_HOST=127.0.0.1
BACKEND_API_PORT=8081
# BACKEND_API_TOKENS=[{"token":"replace-with-strong-token","actorId":"admin","permissions":["audit.events.read"],"allowedChatIds":["-100123"],"systemAdmin":false}]

# Optional audit retention job connection. Migrations create audit_retention as
# NOLOGIN; enable its login and set its password only through the secret store.
AUDIT_RETENTION_DATABASE_URL=postgres://audit_retention:change-me@db.example.internal:5432/telegram_bot

# Optional Redis. TLS remains required while REDIS_ENABLED=true.
REDIS_ENABLED=false
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=telegram-bot:dev:
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Optional S3/MinIO. Custom endpoint and public URL must use HTTPS.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Optional RabbitMQ. AMQPS only.
RABBITMQ_ENABLED=false
RABBITMQ_URL=
RABBITMQ_NAMESPACE=wolfram.ecosystem.dev
RABBITMQ_PRODUCT_ID=telegram-bot
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRIES=5
