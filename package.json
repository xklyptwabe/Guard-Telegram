{
  "name": "guard-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check:locales": "tsx scripts/check-locales.ts",
    "seed:audit-event-types": "tsx scripts/seedAuditEventTypes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@grammyjs/auto-retry": "^2.0.0",
    "@grammyjs/runner": "^2.0.0",
    "amqplib": "^0.10.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.0",
    "grammy": "^1.36.0",
    "i18next": "^25.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/amqplib": "^0.10.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
